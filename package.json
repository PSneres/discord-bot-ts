{
  "name": "my-discord-bot",
  "description": "Um bot utilitário para o discord.",
  "author": "Paulo Silva",
  "license": "MIT",
  "version": "1.0.0",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "imports": {
    "#repositories": "./src/database/repositories/index.js",
    "#models/*": "./src/database/models/*.js",
    "#services/*": "./src/services/*.js",
    "#structures/*": "./src/structures/*.js",
    "#client": "./src/client.js",
    "#config/*": "./src/config/*.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "jest"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "colors": "^1.4.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "mongoose": "^9.10.1"
  }
}
